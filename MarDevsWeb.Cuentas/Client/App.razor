@inject NavigationManager navigationManager

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MiLayout)">
            <Authorizing>
                <text>Autorizando...</text>
            </Authorizing>
            <NotAuthorized>
                @if (true) { navigationManager.NavigateTo("./login"); }
            </NotAuthorized>
        </AuthorizeRouteView>        
    </Found>
    <NotFound>
        <LayoutView Layout="null">
            <CustomNotFound></CustomNotFound>
        </LayoutView>
    </NotFound>    
</Router>
