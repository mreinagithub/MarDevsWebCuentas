@inherits InputBase<string>

<div class="inputWithIcon">
    <input type="@type" @bind="@CurrentValue" class="@CssClass"  @attributes="AdditionalAttributes" />
    <i class="fas fa-lock fa-lg fa-fw" aria-hidden="true"></i>
    <a href="javascript:void(0)" @onclick="CambiarVisibilidadPassword" tabindex="-1"><span class="@iconEye field-icon"></span></a>
</div>


@code {
    string type = "password";
    string iconEye = "fa fa-fw fa-eye";    


    protected override bool TryParseValueFromString(string value, out string result, out string validationErrorMessage)
    {
        result = value;
        validationErrorMessage = null;
        return true;
    }

    private void CambiarVisibilidadPassword()
    {
        if(type == "password")
        {
            type = "text";
            iconEye = "fa fa-fw fa-eye-slash";
        }
        else
        {
            type = "password";
            iconEye = "fa fa-fw fa-eye";
        }

        //StateHasChanged();
    }
}
