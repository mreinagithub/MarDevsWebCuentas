
@inject IJSRuntime js
@inject NavigationManager navManager;

@using ChartJs.Blazor.PieChart
@using Newtonsoft.Json.Linq
 
 <div style="display:contents;">         
                 <div class="card card-extras shadow p-3 bg-white rounded" style="margin-bottom:5px; margin-bottom:5px; padding:0px!important;">                                                                                
                     <div class="card-body" style="padding:0px!important">
            <Chart Config="_pieConfig" SetupCompletedCallback="@SetupCompletedCallback" ></Chart>
                     </div>                      
                 </div>
             </div>        


    


@code {
    private PieConfig _pieConfig;

    [Parameter] public bool ShowTitle { get; set; } = false;
    [Parameter] public string Title { get; set; }
    [Parameter] public List<string> Labels { get; set; } = new List<string>();
    [Parameter] public List<object> Sources { get; set; } = new List<object>();
    [Parameter] public IndexableOption<string> Colors { get; set; }
    [Parameter] public string TipoMovimientoDefinido { get; set; }


    protected async override Task OnInitializedAsync()
    {        

        ConfigurePieConfig();
    }

    private async Task SetupCompletedCallback()
    {        

        await js.InvokeVoidAsync("datalabelsConfig",
           _pieConfig.CanvasId);
    }



    private void ConfigurePieConfig()
    {

        _pieConfig = new PieConfig();        

        _pieConfig.Options = new PieOptions
            {

                Responsive = true,      
                OnClick = new DelegateHandler<ChartMouseEvent>(OnClickHandler),
                Title = new OptionsTitle
                {
                    Display = ShowTitle,
                    Text = Title
                },
                Legend = new Legend
                {
                    Display = true,
                    //FullWidth = true,
                    Position = Position.Left,
                    Labels = new LegendLabels
                    {
                        FontSize = 12,
                        BoxWidth = 10,
                        Padding = 2
                    }
                }                
            };

        foreach (var party in Labels)
        {
            _pieConfig.Data.Labels.Add(party);
        };

        var dataSet = new PieDataset<object>(Sources)
            {                
                BackgroundColor = Colors,
                BorderWidth = 1,
                HoverBorderColor = Colors,
                HoverBorderWidth = 5
            };

        _pieConfig.Data.Datasets.Add(dataSet);        

    }    

    public async void OnClickHandler(JObject mouseEvent, JArray activeElements)
    {
        foreach (JObject elem in activeElements)
        {
            foreach (JProperty prop in elem.GetValue("_model"))
            {
                if (prop.Name.Equals("label"))
                {

                    await js.SetInLocalStorage("rubro-clickeado",prop.Value.ToString());
                    await js.SetInLocalStorage("tipomov-clickeado", TipoMovimientoDefinido);
                    Console.WriteLine(prop.Value.ToString());
                    navManager.NavigateTo("MisMovimientos");
                }
            }
        }
    }
  
  

}


