    private async Task<string> ConvertirURLToBase64String(string url)
    {
        string returnImg = null;
        try
        {
            using (Stream stream = await httpClient.GetStreamAsync(url))
            {
                if (stream == null)
                    return returnImg;
                byte[] buffer = new byte[16384];
                using (MemoryStream ms = new MemoryStream())
                {
                    while (true)
                    {
                        int num = await stream.ReadAsync(buffer, 0, buffer.Length);
                        int read;
                        if ((read = num) > 0)
                            ms.Write(buffer, 0, read);
                        else
                            break;
                    }
                    returnImg = Convert.ToBase64String(ms.ToArray());
                }
                buffer = (byte[])null;
            }
            return returnImg;
        }                    
        catch
        {
            return null;
        }
    }


    private async Task MostrarModalCierreSesion()
    {
        modal.Open();
        await js.Focus("btnCerrarSesion-si");
    }

    private void CancelarCierreSesion()
    {
        modal.Close();
    }

    private async Task Logout()
    {
        var authState = await AuthenticationState;
        if (authState.User.Identity.IsAuthenticated)
        {
            navigationManager.NavigateTo("./logout");
        }
    }

