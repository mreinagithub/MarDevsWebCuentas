@inject IRepositorio repositorio
@inject NavigationManager navigationManager
@inject ErrorHandler errorHandler
@inject AuthenticationStateProvider authProvider
@inject IJSRuntime js
@inject ILoginService loginService

@using System.Globalization
@using MarDevsWeb.Cuentas.Client.Auth


@page "/"

@attribute [Authorize]


<Title Value="MarDevs Cuentas - Inicio"></Title>

@if (!string.IsNullOrWhiteSpace(NombrePila))
{
    <h4 style="margin-left: 10px;">Hola @NombrePila!</h4>

}

<div class="row">         
    <div class="col-12 col-md-6 contenedor-imagen-izquierda">
        <a href="ingreso" class="imagen-seleccionable img-vertical" id="agregarIngesoId" style="text-decoration:none !important; color:black;">
            <Tarjeta Titulo="Ingreso" TextoLinea1="Carga de nuevo ingreso." ColorTitulo="#28a745;">
                <RenderIcono>
                    <i class="fas fa-plus mr-0"></i>
                </RenderIcono>
            </Tarjeta>
        </a>
         <a href="ingreso" class="imagen-seleccionable img-horizonal" id="agregarIngesoId" style="text-decoration:none !important; color:black;">
            <Tarjeta Titulo="Ingreso" TextoLinea1="Carga de nuevo ingreso." ColorTitulo="#28a745;">
                <RenderIcono>
                    <i class="fas fa-plus mr-0"></i>
                </RenderIcono>
            </Tarjeta>
        </a>
    </div> 
    <div class="col-12 col-md-6 contenedor-imagen-derecha">
        <a href="egreso" class="imagen-seleccionable img-vertical" id="agregarEgresoId" style="text-decoration:none !important; color:black;">
            <Tarjeta Titulo="Egreso" TextoLinea1="Carga de nuevo egreso." ColorTitulo="#FF7276">
                <RenderIcono>
                    <i class="fas fa-minus mr-0"></i>
                </RenderIcono>
            </Tarjeta>
        </a>
         <a href="egreso" class="imagen-seleccionable img-horizonal" id="agregarEgresoId" style="text-decoration:none !important; color:black;">
            <Tarjeta Titulo="Egreso" TextoLinea1="Carga de nuevo egreso." ColorTitulo = "#FF7276">
                <RenderIcono>
                    <i class="fas fa-minus mr-0"></i>
                </RenderIcono>
            </Tarjeta>
        </a>
    </div>   
</div>
    
<div class="row">
    <div class="col-12">

        @if(Model == null)
        {
               <div style="text-align:center;">
                    <span style="color: var(--color-primario); justify-content:space-evenly; font-size:30px; padding-top:30px; padding-bottom:30px;" class="img-fluid img-vertical"><i class="fas fa-circle-notch fa-spin fa-lg"></i></span>
                    <span style="color: var(--color-primario); justify-content:space-evenly; font-size:30px; padding-top:30px; padding-bottom:30px;" class="img-fluid img-horizonal"><i class="fas fa-circle-notch fa-spin fa-lg"></i></span>
                </div>
        }
        else
        {            
             <a href="MisMovimientos" class="imagen-seleccionable img-vertical" id="resumenId" style="text-decoration:none !important; color:black; margin-top:15px;">
                 <Tarjeta Titulo="@fechaDesde" TextoLinea1="@saldoInicial" TextoLinea2="@ingresos" TextoLinea3="@egresos" ColorLinea2="#28a745" ColorLinea3= "#FF7276">
                    <RenderIcono>
                        <i class="fas fa-comment-dollar mr-0"></i>
                    </RenderIcono>
                </Tarjeta>          
            </a>
             <a href="MisMovimientos" class="imagen-seleccionable img-horizonal" id="resumenId" style="text-decoration:none !important; color:black;">
                <Tarjeta Titulo="@fechaDesde" TextoLinea1="@saldoInicial" TextoLinea2="@ingresos" TextoLinea3="@egresos" ColorLinea2="#28a745" ColorLinea3= "#FF7276">
                    <RenderIcono>
                        <i class="fas fa-comment-dollar mr-0"></i>
                    </RenderIcono>
                </Tarjeta>          
            </a>       
        }
    </div>
</div> 



@code{
    string NombrePila { get; set; }
    protected ResumenHomeDTO Model { get; set; } = null;    


    private string saldoInicial = "";
    private string ingresos = "";
    private string egresos = "";
    private string fechaDesde = "";

    protected async override Task OnInitializedAsync()
    {        
        NombrePila = await loginService.ObtenerNombrePilaUsuario();        

        await Actualizar();
    }

    async Task Actualizar()
    {
        var httpReponse = await repositorio.Get<ResumenHomeDTO>("api/movimiento/resumenHome");
        if (httpReponse.Error)
        {
            await errorHandler.MostrarError(httpReponse.HttpResponseMessage);
        }
        else
        {
           

            Model = httpReponse.Response;
            fechaDesde = $"Movimientos desde {Model.FechaDesde:dd/MM/yyyy}";
            saldoInicial = $"Saldo Inicial: {Model.SaldoInicial:C2}";
            ingresos = $"Total Ingresos: {Model.TotalIngresos:C2}";
            egresos = $"Total Egresos: {Model.TotalEgresos:C2}";

        }
    }

}