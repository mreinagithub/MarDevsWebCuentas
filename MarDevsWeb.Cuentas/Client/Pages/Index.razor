@code{
    string NombrePila { get; set; }
    protected ResumenHomeDTO Model { get; set; } = null;
    protected List<ResumenPorRubroDTO> EgresosGrafico { get; set; } = null;
    protected List<ResumenPorRubroDTO> IngresosGrafico { get; set; } = null;

    private List<string> labelsEgreso = new List<string>();   // { "Alimentos", "Salud","Coche","Esparcimiento"};
    private List<object> sourcesEgreso = new List<object>();  // { 18290.5, 3550.57, 12299.0, 3550.27 };
    private IndexableOption<string> colorsEgreso; //{ "Red", "Blue", "Green", "#e817a6" };
    private List<string> labelsIngreso = new List<string>();   // { "Alimentos", "Salud","Coche","Esparcimiento"};
    private List<object> sourcesIngreso = new List<object>();  // { 18290.5, 3550.57, 12299.0, 3550.27 };
    private IndexableOption<string> colorsIngreso; //{ "Red", "Blue", "Green", "#e817a6" };

    private string saldoInicial = "";
    private string ingresos = "";
    private string egresos = "";
    private string fechaDesde = "";
    private string saldo = "";    

    protected async override Task OnInitializedAsync()
    {        
        NombrePila = await loginService.ObtenerNombrePilaUsuario();

        //Ejecución en paralelo
        var actualizarResumenMovimientos = Actualizar();
        var actualizarGraficoEgreso = GraficoEgresos();
        var actualizarGraficoIngreso = GraficoIngresos();

        await Task.WhenAll(actualizarResumenMovimientos, actualizarGraficoEgreso, actualizarGraficoIngreso);

        //await Actualizar();
        //await GraficoEgresos();
        //await GraficoIngresos();
    }    



    async Task Actualizar()
    {
        var httpReponse = await repositorio.Get<ResumenHomeDTO>("api/movimiento/resumenHome");
        if (httpReponse.Error)
        {
            await errorHandler.MostrarError(httpReponse.HttpResponseMessage);
        }
        else
        {


            Model = httpReponse.Response;
            fechaDesde = $"Movimientos desde {Model.FechaDesde:dd/MM/yyyy}";

            if (Model.MostrarSaldoInicial) {
                saldoInicial = $"Saldo Inicial: {Model.SaldoInicial:C2}";
            }
            else {
                saldoInicial = "";
            }

            ingresos = $"Total Ingresos: {Model.TotalIngresos:C2}";
            egresos = $"Total Egresos: {Model.TotalEgresos:C2}";
            saldo = $"Saldo actual: {Model.Saldo:C2}";

            StateHasChanged();

        }
    }
    async Task GraficoEgresos()
    {
        var httpReponse = await repositorio.Get<List<ResumenPorRubroDTO>>("api/movimiento/egreso-rubro-chart");
        if (httpReponse.Error)
        {
            await errorHandler.MostrarError(httpReponse.HttpResponseMessage);
        }
        else
        {


            EgresosGrafico = httpReponse.Response;

            labelsEgreso = EgresosGrafico.Select(e => e.Rubro).ToList();
            sourcesEgreso = EgresosGrafico.Select(e => (object)e.Importe).ToList();
            colorsEgreso = EgresosGrafico.Select(e => e.Color).ToArray();    
            
            StateHasChanged();
        }
    }
     async Task GraficoIngresos()
    {
        var httpReponse = await repositorio.Get<List<ResumenPorRubroDTO>>("api/movimiento/ingreso-rubro-chart");
        if (httpReponse.Error)
        {
            await errorHandler.MostrarError(httpReponse.HttpResponseMessage);
        }
        else
        {


            IngresosGrafico = httpReponse.Response;

            labelsIngreso = IngresosGrafico.Select(e => e.Rubro).ToList();
            sourcesIngreso = IngresosGrafico.Select(e => (object)e.Importe).ToList();
            colorsIngreso = IngresosGrafico.Select(e => e.Color).ToArray();

            StateHasChanged();
            
        }
    }

}