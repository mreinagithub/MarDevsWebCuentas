@layout LoginLayout

@page "/Login"

@inject IRepositorio repositorio
@inject NavigationManager navigationManager
@inject ILoginService loginService
@inject IMostrarMensajes mostrarMensajes
@inject IJSRuntime js
@inject AuthenticationStateProvider authProvider


@using MarDevsWeb.Cuentas.Client.Auth


<Title Value="MarDevs Cuentas - Login"></Title>


<EditForm Model="userInfo" OnValidSubmit="LoginUsuario" autocomplete="off">
    <div class="form-signin">
        <span style="text-align:match-parent;" class="form-logo">
            <img src="./Imagenes/MarDevsCuentasBgTransparentHD.png" alt="MarDevs logo" />
        </span>
        <DataAnnotationsValidator />
        <div class="row p-b-30">
            <div class="col-12">
                <div class="form-group  mb-3">
                    <InputTexto class="form-control" @bind-Value="@userInfo.Email" id="txtLogonId" placeholder="Email"/>
                    <ValidationMessage For="@(()=> userInfo.Email)" />
                </div>
            </div>
        </div>
        <div class="row p-b-30">
            <div class="col-12">
                <div class="form-group  mb-3">
                    <InputPassword class="form-control" @bind-Value="@userInfo.Password" id="txtPassId" placeholder="Clave" />                    
                    <ValidationMessage For="@(()=> userInfo.Password)" />
                </div>
            </div>
        </div>
        @if (!String.IsNullOrWhiteSpace(MensajeErrorAutenticacion))
        {
            <p style="text-align:left;color:red">@MensajeErrorAutenticacion</p>
        }
        <button type="submit" class="btn btn-custom col-12">
            @if (!Autenticando)
            {
                <text>Ingresar</text>
            }
            else
            {
                <i class="fas fa-circle-notch fa-spin"></i><text> Autenticando...</text>
            }
        </button>
        <div  style="margin-top:15px;">                        
            <p><a href="javascript:void(0)" @onclick="RecuperarClave"><b>¿Olvidaste tu clave?</b></a></p>            
            <p><a href="./registro"><b>¿Sos Nuevo? Registrate acá...</b></a></p>                           
        </div> 
        <button type="button" class="btn btn-danger col-12" @onclick="AccesoGoogle">
            <i class="fab fa-google"></i>
                Accede con Google              
            </button>      
    </div>
</EditForm>


@code {

    private UserInfo userInfo = new UserInfo();
    private bool Autenticando { get; set; } = false;
    private string MensajeErrorAutenticacion = "";

    protected override async Task OnInitializedAsync()
    {

        //Si ya estoy logueado me voy al home
        var authState = await authProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity.IsAuthenticated)
        {
            navigationManager.NavigateTo("./");
        }
        else
        {
            var ultusrlog = await loginService.ObtenerUltimoUsuarioLogueado();

            if (!string.IsNullOrWhiteSpace(ultusrlog))
            {
                userInfo.Email = ultusrlog;
                await js.Focus("txtPassId");
            }
            else
            {
                await js.Focus("txtLogonId");
            }
        }
    }

    private async Task LoginUsuario()
    {
        Autenticando = true;
        MensajeErrorAutenticacion = "";
        var httpReponse = await repositorio.Post<UserInfo, UserToken>("api/cuenta/login", userInfo);
        if (httpReponse.Error)
        {
            Autenticando = false;
            MensajeErrorAutenticacion = await httpReponse.GetBody();
        }
        else
        {
            Autenticando = false;
            MensajeErrorAutenticacion = "";
            await loginService.Login(httpReponse.Response);
            navigationManager.NavigateTo("./");
        }

    }

    private async Task RecuperarClave()
    {

        await js.SetInSessionStorage("emailRecuClave", userInfo.Email);
        navigationManager.NavigateTo("./recuperar-clave");

    }

    private void AccesoGoogle()
    {
         navigationManager.NavigateTo("api/cuenta/GoogleSignIn", true);
    }

}
