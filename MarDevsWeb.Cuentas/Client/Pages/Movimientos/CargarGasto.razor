@* @page "/cargar-gasto"
@inject IJSRuntime JS
@inject GastoProcesadorService ProcesadorService
@implements IAsyncDisposable

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Registrar Nuevo Gasto</h5>

            <!-- Botón Push-To-Talk -->
            <button type="button"
                    class="btn btn-light btn-sm rounded-circle @(estaEscuchando ? "btn-danger text-white pulse-animation" : "")"
                    @onmousedown="IniciarDictado"
                    @onmouseup="DetenerDictado"
                    @ontouchstart="IniciarDictado"
                    @ontouchend="DetenerDictado"
                    disabled="@estaProcesando"
                    title="Mantén presionado para dictar por voz">
                @if (estaProcesando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>🎙️</span>
                }
            </button>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(mensajeAlerta))
            {
                <div class="alert @claseAlerta alert-dismissible fade show" role="alert">
                    @mensajeAlerta
                    <button type="button" class="close" @onclick="() => mensajeAlerta = null" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            <p style="color:black;">@literal</p>

            <form @onsubmit="GuardarMovimiento">
                <div class="form-group">
                    <label for="concepto">Concepto</label>
                    <input type="text" class="form-control" id="concepto" @bind="gastoForm.Concepto" placeholder="Ej: Almuerzo, Nafta...">
                </div>

                <div class="form-group">
                    <label for="importe">Importe ($)</label>
                    <input type="number" step="0.01" class="form-control" id="importe" @bind="gastoForm.Importe" placeholder="0.00">
                </div>

                <button type="submit" class="btn btn-success btn-block mt-4">Confirmar Gasto</button>
            </form>
        </div>
    </div>
</div>

@code {
    private GastoForm gastoForm = new();
    private bool estaEscuchando = false;
    private bool estaProcesando = false;
    private string? mensajeAlerta;
    private string claseAlerta = "alert-info";
    private string? literal;

    private IJSObjectReference? moduloJs;
    private DotNetObjectReference<CargarGasto>? dotNetReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            moduloJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/vocal.js");
            dotNetReference = DotNetObjectReference.Create(this);
        }
    }

    private async Task IniciarDictado()
    {
        if (moduloJs is not null && !estaEscuchando && !estaProcesando)
        {
            estaEscuchando = true;
            mensajeAlerta = "Habla ahora... Suelta el botón al finalizar.";
            claseAlerta = "alert-info";

            await moduloJs.InvokeVoidAsync("iniciarGrabacionVoz", dotNetReference);
        }
    }

    private async Task DetenerDictado()
    {
        if (moduloJs is not null && estaEscuchando)
        {
            estaEscuchando = false;
            estaProcesando = true;
            mensajeAlerta = "Procesando audio...";
            claseAlerta = "alert-warning";
            StateHasChanged();

            await moduloJs.InvokeVoidAsync("detenerGrabacionVoz");
        }
    }

    [JSInvokable]
    public void ProcesarComandoVoz(string textoDictado)
    {
        estaProcesando = false;
        literal = textoDictado;

        if (string.IsNullOrWhiteSpace(textoDictado))
        {
            mensajeAlerta = "No se logró capturar audio. Inténtalo nuevamente manteniendo presionado el botón.";
            claseAlerta = "alert-danger";
            StateHasChanged();
            return;
        }

        var resultado = ProcesadorService.ProcesarFrase(textoDictado);

        if (resultado.EsUnivoco)
        {
            gastoForm.Concepto = resultado.Concepto;
            gastoForm.Importe = resultado.Importe;

            mensajeAlerta = $"¡Gasto detectado! Se registró automáticamente '{resultado.Concepto}' por ${resultado.Importe}.";
            claseAlerta = "alert-success";

            GuardarMovimiento();
        }
        else
        {
            gastoForm.Concepto = resultado.Concepto ?? gastoForm.Concepto;
            gastoForm.Importe = resultado.Importe ?? gastoForm.Importe;

            mensajeAlerta = $"Interpretado: \"{textoDictado}\". Por favor verifica los datos y presiona Confirmar.";
            claseAlerta = "alert-warning";
        }

        StateHasChanged();
    }

    private void GuardarMovimiento()
    {
        Console.WriteLine($"Gasto impactado: {gastoForm.Concepto} - ${gastoForm.Importe}");
    }

    public async ValueTask DisposeAsync()
    {
        dotNetReference?.Dispose();
        if (moduloJs is not null)
        {
            await moduloJs.DisposeAsync();
        }
    }

    public class GastoForm
    {
        public string? Concepto { get; set; }
        public decimal? Importe { get; set; }
    }
} *@