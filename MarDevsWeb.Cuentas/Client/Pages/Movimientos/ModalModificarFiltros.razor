<div class="container">
    <!-- The Modal -->
    <div class="modal fade" id="modarModificarFiltrosBusqueda">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header modal-header-form">
                    <button type="button" id="btnCerrar" class="close mr-1" data-dismiss="modal"  @onclick="CancelarCambios">&times;</button>
                    <div class="modal-title modal-title-form">
                        @*<span><i class="fas fa-shopping-cart"></i></span>*@
                        <b>Modificar filtros de búsqueda</b>
                    </div>

                </div>
                <!-- Modal body -->                 
                <div class="modal-body" id="editarFormItemPedido">
                    <div class="row">                            
                        <div class="col-12">                                
                             <div class="form-group mb-1">                                    
                                 <label class="control-label small mb-0 font-weight-bold">Tipo Movimiento</label>                                                                                                                                
                                 <select class="form-control " id="lstTiposMovimiento" autocomplete="off" @bind="@TipoMovimiento">                                        
                                     <option value="TODOS">--TODOS--</option>
                                     <option value="egreso">Egresos</option>
                                     <option value="ingreso">Ingresos</option>
                                 </select>                                             
                             </div>                            
                        </div>
                    </div>
                    @if (Rubros != null)
                    {
                        <div class="row">                            
                            <div class="col-12">                                
                                <div class="form-group mb-1">                                    
                                    <label class="control-label small mb-0 font-weight-bold">Rubro</label>                                                                                                                                
                                    <select class="form-control " id="lstRubros" autocomplete="off" @bind="@Rubro">                                        
                                        <option value="">--TODOS--</option>
                                        <option value="[sin_rubro]">[SIN RUBRO]</option>
                                        @foreach (var rubro in Rubros)
                                        {
                                            <option value="@rubro.Id">@($"{rubro.Descripcion}")</option>
                                        }  
                                    </select>                                             
                                </div>                            
                            </div>
                        </div>
                    }
                    @if (OtrosPeriodos != null)
                    {
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group mb-1">
                                    <label class="control-label small mb-0 font-weight-bold">Periodo</label>                                                                                            
                                    <select class="form-control " id="lstPeriodosElegibles" autocomplete="off" @onchange="ModificarSeleccion">
                                        <option value="default">--Buscar otro periodo--</option>
                                        @foreach (var periodo in OtrosPeriodos)
                                        {
                                            <option value="@periodo.Id">@($"{periodo.Desde:dd/MM/yyyy} a {periodo.Hasta:dd/MM/yyyy}")</option>
                                        }                                    
                                    </select>             

                                </div>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group mb-1">
                                <label class="control-label small mb-0 font-weight-bold">Desde</label>                                
                                <input @bind="@FechaDesde" class="form-control" type="date" min="@($"{minFecha:yyyy-MM-dd}")" max="@($"{maxFecha:yyyy-MM-dd}")"></input>
                            </div>
                        </div>
                    </div>
                     <div class="row">
                        <div class="col-12">
                            <div class="form-group mb-1">
                                <label class="control-label small mb-0 font-weight-bold">Hasta</label>                                
                                <input @bind="@FechaHasta" class="form-control" type="date" min="@($"{minFecha:yyyy-MM-dd}")" max="@($"{maxFecha:yyyy-MM-dd}")"></input>
                            </div>
                        </div>
                    </div>
                    @if (!String.IsNullOrWhiteSpace(errorAlProcesar))
                    {
                        <p style="text-align:left;color:red">@errorAlProcesar</p>
                    }
                    <div class="row border-secondary" style="margin-top:15px;">
                        <div class="col-4">                                
                            <div class="p-t-10">                                    
                                <button class="btn btn-custom-secondary btn-sm col-12" id="btnCancelar" type="button" @onclick="CancelarCambios">                                        
                                    Cancelar                                    
                                </button>
                            </div>                            
                        </div>                            
                        <div class="col-8">                                
                            <div class="p-t-10">                                    
                                <button class="btn btn-custom btn-sm col-12" id="btnActualizarFechasBusqueda" type="button" @onclick="ProcesarSeleccion">                                        
                                    Actualizar                                    
                                </button>                                
                            </div>                            
                        </div>                                                    
                    </div>                    
                </div>                
            </div>            
        </div>
    </div>
</div>


@code{

    [Parameter] public string TipoMovimiento { get; set; }
    [Parameter] public string Rubro { get; set; }
    [Parameter] public DateTime? FechaDesde { get; set; }
    [Parameter] public DateTime? FechaHasta { get; set; }
    [Parameter] public List<PeriodoDTO> OtrosPeriodos { get; set; }    
    [Parameter] public List<RubroDTO> Rubros { get; set; }

    [Parameter] public EventCallback<string> RubroChanged { get; set; }
    [Parameter] public EventCallback<string> TipoMovimientoChanged { get; set; }
    [Parameter] public EventCallback<DateTime?> FechaDesdeChanged { get; set; }
    [Parameter] public EventCallback<DateTime?> FechaHastaChanged { get; set; }
    [Parameter] public EventCallback AlCancelarCambioFecha { get; set; }
    [Parameter] public EventCallback ProcesarCambioFecha { get; set; }
    [Parameter] public EventCallback RestablecerFechasDefault { get; set; }

    string errorAlProcesar = "";
    DateTime? minFecha;
    DateTime? maxFecha;

    protected override void OnInitialized()
    {
        errorAlProcesar = "";
        minFecha = FechaDesde;
        maxFecha = FechaHasta;
    }

    async Task CancelarCambios()
    {
        errorAlProcesar = "";
        await AlCancelarCambioFecha.InvokeAsync();
    }


    async Task ProcesarSeleccion()
    {
        errorAlProcesar = "";
        if(FechaDesde == null || FechaHasta == null)
        {
            errorAlProcesar = "Debe seleccionar las fechas desde y hasta";
            StateHasChanged();
        }
        else
        {
            await RubroChanged.InvokeAsync(Rubro);
            await TipoMovimientoChanged.InvokeAsync(TipoMovimiento);
            await FechaDesdeChanged.InvokeAsync(FechaDesde);
            await FechaHastaChanged.InvokeAsync(FechaHasta);            
            await ProcesarCambioFecha.InvokeAsync();    
        }        
    }

    void ModificarSeleccion(ChangeEventArgs e)
    {
        bool esInt = Guid.TryParse(e.Value.ToString(), out Guid idPeriodo);
        if(esInt)
        {
            var periodo = OtrosPeriodos.FirstOrDefault(p => p.Id == idPeriodo);
            FechaDesde = periodo.Desde;
            FechaHasta = periodo.Hasta;
            minFecha = FechaDesde;
            maxFecha = FechaHasta;
        }
    }
}