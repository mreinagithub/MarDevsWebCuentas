@* @page "/cargar-gasto-old"
@inject IJSRuntime JS
@inject GastoProcesadorService ProcesadorService
@implements IAsyncDisposable

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Registrar Nuevo Gasto</h5>

            <!-- Botón de voz con clases de Bootstrap 4 -->
            <button type="button"
                    class="btn btn-light btn-sm rounded-circle @(estaEscuchando ? "btn-danger text-white" : "")"
                    @onclick="ActivarMicrofono"
                    title="Dictar gasto por voz">
                🎙️
            </button>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(mensajeAlerta))
            {
                <div class="alert @claseAlerta alert-dismissible fade show" role="alert">
                    @mensajeAlerta
                    <button type="button" class="close" @onclick="() => mensajeAlerta = null" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            <p style="color:black;">@literal</p>

            <form @onsubmit="GuardarMovimiento">
                <div class="form-group">
                    <label for="concepto">Concepto</label>
                    <input type="text" class="form-control" id="concepto" @bind="gastoForm.Concepto" placeholder="Ej: Almuerzo, Nafta...">
                </div>

                <div class="form-group">
                    <label for="importe">Importe ($)</label>
                    <input type="number" step="0.01" class="form-control" id="importe" @bind="gastoForm.Importe" placeholder="0.00">
                </div>

                <button type="submit" class="btn btn-success btn-block mt-4">Confirmar Gasto</button>
            </form>
        </div>
    </div>
</div>

@code {
    private GastoForm gastoForm = new();
    private bool estaEscuchando = false;
    private string? mensajeAlerta;
    private string claseAlerta = "alert-info";
    private string? literal;

    // Referencia en memoria al módulo JavaScript para evitar fugas y errores de carga
    private IJSObjectReference? moduloJs;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cargamos de forma segura el script de inicialización desde wwwroot
            moduloJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/vocal.js");
        }
    }

    private async Task ActivarMicrofono()
    {
        if (moduloJs is not null)
        {
            estaEscuchando = true;
            mensajeAlerta = "Escuchando... Di algo como: 'Almuerzo por 1500 pesos'";
            claseAlerta = "alert-info";

            // Permite a JavaScript saber a qué componente exacto devolverle los datos
            var dotNetReference = DotNetObjectReference.Create(this);

            // Invoca la función del archivo vocal.js
            await moduloJs.InvokeVoidAsync("inicializarReceptorVoz", dotNetReference);
        }
    }

    [JSInvokable]
    public async Task ProcesarComandoVoz(string textoDictado)
    {
        estaEscuchando = false;

        // Ejecutamos la lógica algorítmica local en el WebAssembly
        var resultado = ProcesadorService.ProcesarFrase(textoDictado);

        await Task.Delay(1000);

        literal = textoDictado;

        if (resultado.EsUnivoco)
        {
            // CASO 1: Concepto e importe identificados unívocamente -> Completar y simular guardado directo
            gastoForm.Concepto = resultado.Concepto;
            gastoForm.Importe = resultado.Importe;

            mensajeAlerta = $"¡Gasto detectado! Se registró automáticamente '{resultado.Concepto}' por ${resultado.Importe}.";
            claseAlerta = "alert-success";

            GuardarMovimiento();
        }
        else
        {
            // CASO 2: Datos ambiguos o incompletos -> Rellenar lo que se pueda y esperar corrección manual
            gastoForm.Concepto = resultado.Concepto ?? gastoForm.Concepto;
            gastoForm.Importe = resultado.Importe ?? gastoForm.Importe;

            mensajeAlerta = $"Interpretado: \"{textoDictado}\". Por favor verifica los datos y presiona Confirmar.";
            claseAlerta = "alert-warning";
        }

        // Obliga a Blazor a repintar la UI tras la respuesta asíncrona de JavaScript
        StateHasChanged();
    }

    private void GuardarMovimiento()
    {
        // Aquí ejecutas tu llamada HTTP hacia el backend (Server) usando HttpClient
        Console.WriteLine($"Gasto impactado: {gastoForm.Concepto} - ${gastoForm.Importe}");
    }

    // Método del ciclo de vida para destruir el objeto JS de la memoria del navegador al salir de la página
    public async ValueTask DisposeAsync()
    {
        if (moduloJs is not null)
        {
            await moduloJs.DisposeAsync();
        }
    }

    // Modelo interno del Formulario
    public class GastoForm
    {
        public string? Concepto { get; set; }
        public decimal? Importe { get; set; }
    }
}
 *@